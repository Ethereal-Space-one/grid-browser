{
  "name": "grid-electron-m0",
  "version": "0.2.0",
  "private": true,
  "description": "Grid M0 value prototype",
  "main": "dist/main.js",
  "scripts": {
    "test:e2e:key-storage": "npm run build && node scripts/e2e-key-storage.cjs",
    "test:package:mac": "node scripts/smoke-package.cjs",
    "test:e2e:visual": "npm run build && electron scripts/e2e-visual.cjs",
    "package:mac": "npm run build && python3 scripts/package-mac.py",
    "test:e2e:scenes:live": "npm run build && electron scripts/e2e-scenes-live.cjs",
    "test:e2e:requests": "npm run build && electron scripts/e2e-requests.cjs",
    "test:e2e:tabs": "npm run build && electron scripts/e2e-tabs.cjs",
    "test:e2e:navigation": "npm run build && electron scripts/e2e-navigation.cjs",
    "test:e2e:path-state": "npm run build && electron scripts/e2e-path-state.cjs",
    "test:e2e:path-map": "npm run test:e2e:reading-flow",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test dist/intent.test.js dist/search.test.js dist/bridge.test.js dist/form-action.test.js dist/scenes.test.js dist/browsing-session.test.js dist/request-boundaries.test.js dist/navigation-tabs.test.js dist/native-visits.test.js dist/understanding.test.js dist/comparison.test.js dist/judgment.test.js dist/task-storage.test.js dist/reading-flow.test.js",
    "test:e2e:live": "npm run build && electron scripts/e2e-live.cjs",
    "test:e2e:live:inspect": "npm run build && electron scripts/e2e-live.cjs --keep-open",
    "test:e2e:mcp": "npm run build && electron scripts/e2e-mcp.cjs",
    "test:e2e:scenes": "npm run build && electron scripts/e2e-scenes.cjs",
    "test:e2e:actions": "npm run build && electron scripts/e2e-actions.cjs",
    "test:e2e:hosts:forms": "npm run build && electron scripts/e2e-hosts.cjs --propose",
    "test:e2e:hosts": "npm run build && electron scripts/e2e-hosts.cjs",
    "test:e2e:understanding": "npm run build && electron scripts/e2e-understanding.cjs",
    "test:e2e:comparison": "npm run build && electron scripts/e2e-comparison.cjs",
    "test:e2e:judgment": "npm run build && electron scripts/e2e-judgment.cjs",
    "test:e2e:storage": "npm run build && node scripts/e2e-storage.cjs",
    "test:package:flow": "node scripts/smoke-package-flow.cjs",
    "test:e2e:reading-flow": "npm run build && electron scripts/e2e-reading-flow.cjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^24.0.0",
    "electron": "45.2.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  }
}
